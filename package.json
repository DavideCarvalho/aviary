{
  "name": "aviary",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "sync:docs": "node scripts/sync-docs.mjs",
    "sync:registry": "node ../nestjs-agent/registry/scripts/build-registry.mjs --out ../aviary/public/r",
    "prebuild": "node scripts/sync-docs.mjs && node scripts/check-links.mjs --strict",
    "build": "next build",
    "postbuild": "node scripts/postbuild-og.mjs",
    "predev": "node scripts/sync-docs.mjs",
    "dev": "next dev",
    "start": "serve out",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "biome check",
    "format": "biome format --write",
    "check:links": "node scripts/check-links.mjs --strict"
  },
  "dependencies": {
    "fumadocs-core": "16.15.11",
    "fumadocs-mdx": "15.0.12",
    "fumadocs-ui": "16.15.8",
    "lucide-react": "^1.17.0",
    "next": "16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.6.0",
    "zbsearch": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "postcss": "^8.5.15",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "@biomejs/biome": "^2.5.0"
  }
}
